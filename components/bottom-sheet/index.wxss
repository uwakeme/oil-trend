@import "../../styles/tokens.wxss";
@import "../../styles/components.wxss";

/*
 * 遮罩与面板的基础样式在 styles/components.wxss（唯一真源），
 * 这里不再重复一份，只保留出场动画。
 * ⚠️ 基础样式里没有 animation，规则整个删掉动画也会跟着没了。
 */
.sheet-mask {
  animation: maskIn .22s ease both;
}

.sheet-panel {
  animation: sheetUp .25s ease both;
}

.sheet-content {
  padding-bottom: 8rpx;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
