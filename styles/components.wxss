/* ===========================================================
 * 通用组件类：卡片 / 徽章 / 按钮 / 分段控件 / 弹层 / 表单
 * 所有页面共用，避免同名样式散落在各页面里
 * =========================================================== */

/* ---------- 卡片 ---------- */
.card {
  background: rgba(255, 254, 249, .88);
  border: 1px solid rgba(23, 35, 30, .07);
  border-radius: 18px;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 0 rgba(23, 35, 30, .025);
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 26rpx;
}

.card-title { font-size: 26rpx; font-weight: 750; }
.card-link { font-size: 20rpx; color: var(--muted); }

/* ---------- 文本 ---------- */
.micro { font-size: 18rpx; color: var(--muted); line-height: 1.6; }
.num { font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.up { color: var(--red); }
.down { color: var(--green); }

/* ---------- 徽章 ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  white-space: nowrap;
}
.badge.down { background: var(--green-soft); color: var(--green); }
.badge.up { background: var(--red-soft); color: var(--red); }
.badge.neutral { background: #eceae2; color: #626a64; }
.badge.amber { background: var(--amber-soft); color: var(--amber-ink); }
/* flat = 无方向：持平或幅度未知，不能染成涨跌色 */
.badge.flat { background: #eceae2; color: #626a64; }

/* ---------- 按钮 ---------- */
.primary-button {
  width: 100%;
  border: none;
  background: var(--amber);
  color: #272315;
  border-radius: 26rpx;
  min-height: 88rpx;
  padding: 22rpx 30rpx;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  line-height: 1.4;
}
.primary-button.dark { background: var(--night); color: #fff; }
.primary-button.muted { background: #d8d5cb; color: #8a8f89; }

.secondary-button {
  border: 1rpx solid var(--line);
  background: #fffdf7;
  color: var(--ink);
  border-radius: 24rpx;
  min-height: 80rpx;
  padding: 18rpx 28rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

/* ---------- 分段控件 ---------- */
.segmented {
  padding: 6rpx;
  border-radius: 24rpx;
  background: #e8e5db;
  display: flex;
  gap: 4rpx;
  margin-bottom: 26rpx;
}
.segmented-item {
  flex: 1;
  border: none;
  background: transparent;
  border-radius: 18rpx;
  padding: 16rpx 0;
  font-size: 20rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.3;
}
.segmented-item.active {
  background: var(--white);
  color: var(--ink);
  font-weight: 750;
  box-shadow: 0 4rpx 12rpx rgba(23, 35, 30, .07);
}

/* ---------- 胶囊周期选择 ---------- */
.period-row { display: flex; gap: 14rpx; margin: 12rpx 0 30rpx; flex-wrap: wrap; }
.period-item {
  border: 1rpx solid var(--line);
  background: transparent;
  border-radius: 16rpx;
  font-size: 18rpx;
  padding: 12rpx 22rpx;
  color: var(--muted);
  line-height: 1.3;
}
.period-item.active {
  border-color: var(--night);
  color: var(--night);
  background: var(--white);
  font-weight: 700;
}

/* ---------- 开关 ---------- */
.switch {
  width: 78rpx;
  height: 46rpx;
  flex: 0 0 78rpx;
  border: none;
  border-radius: 40rpx;
  background: #cccac2;
  padding: 6rpx;
  position: relative;
  transition: background .2s;
}
.switch::after {
  content: "";
  display: block;
  width: 34rpx;
  height: 34rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .18);
  transition: transform .2s;
}
.switch.on { background: var(--green); }
.switch.on::after { transform: translateX(32rpx); }

/* ---------- 底部弹层 ---------- */
/*
 * 单一真源：components/bottom-sheet/index.wxss 只写动画与内部间距，
 * 遮罩与面板的基础样式都在这里 —— 以前两边各写一份同名规则，
 * 靠「后写的覆盖先写的」生效，改样式时很容易改错文件。
 */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 20, 15, .46);
  z-index: 100;
}
.sheet-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 101;
  /* 面板本身不再滚动：滚动交给里面的 scroll-view，
     否则长列表（31 个省）在真机上滚不动 */
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  border-radius: 50rpx 50rpx 0 0;
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-scroll {
  /* scroll-view 必须给高度约束，否则内容会撑开整个面板 */
  max-height: calc(84vh - 190rpx);
  flex: 1 1 auto;
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #cbc9c0;
  margin: 0 auto 36rpx;
  flex: 0 0 auto;
}
.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  flex: 0 0 auto;
}
.sheet-head-title {
  font-size: 34rpx;
  font-family: var(--font-title);
  font-weight: 700;
}
.sheet-close {
  border: none;
  background: #e8e5db;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  margin: 0;
  border-radius: 50%;
  font-size: 32rpx;
  line-height: 52rpx;
  color: var(--ink);
  padding: 0;
}
.sheet-body { font-size: 22rpx; line-height: 1.8; color: var(--muted); }

/* ---------- 来源提示条 ---------- */
/*
 * 五页统一显示「这次数据从哪来」。
 * 后端挂了回落演示数据时必须看得见 —— 静默换成演示数据装没事，
 * 等于骗用户以为看到的是真实油价。
 */
.source-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #ece8dc;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.5;
}
.source-bar.warn {
  background: rgba(176, 92, 40, .12);
  color: #a8551f;
}
.source-bar-text { flex: 1 1 auto; }

/* ---------- 信息条 ---------- */
.info-strip {
  display: flex;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: #ece8dc;
  margin-bottom: 24rpx;
}
.info-strip-icon { flex: 0 0 34rpx; width: 34rpx; height: 34rpx; margin-top: 2rpx; }
.info-strip-title { display: block; font-size: 20rpx; margin-bottom: 8rpx; color: var(--ink); font-weight: 700; }
.info-strip-text { font-size: 18rpx; line-height: 1.6; color: var(--muted); }

/* ---------- 数据脚注 ---------- */
.data-footnote {
  text-align: center;
  color: #969a94;
  font-size: 16rpx;
  line-height: 1.7;
  padding: 10rpx 24rpx 0;
}

/* WXML 没有 <br>，换行用块级 text */
.foot-line {
  display: block;
}

/* ---------- 状态提示 ---------- */
.state-box {
  padding: 56rpx 32rpx;
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
}
.state-box-title { font-size: 26rpx; color: var(--ink); margin-bottom: 12rpx; font-weight: 700; }

/* ---------- 轻提示 ---------- */
.toast {
  position: fixed;
  left: 50%;
  bottom: 180rpx;
  transform: translateX(-50%);
  border-radius: 20rpx;
  background: rgba(20, 44, 35, .94);
  color: #fff;
  font-size: 20rpx;
  padding: 20rpx 28rpx;
  z-index: 200;
  max-width: 80%;
  text-align: center;
  line-height: 1.5;
}
