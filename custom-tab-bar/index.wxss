@import "../styles/tokens.wxss";

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding: 12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 254, 249, .96);
  border-top: 1rpx solid rgba(23, 35, 30, .07);
  display: flex;
  align-items: flex-start;
  z-index: 90;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #929790;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  font-size: 18rpx;
  line-height: 1.2;
}

.tab-item.active {
  color: var(--night);
}

.tab-item.active .tab-label {
  font-weight: 800;
}
