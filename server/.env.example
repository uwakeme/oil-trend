# 复制成 .env 后填真实值。.env 不入库。

# 服务端口
PORT=3000

# 微信小程序凭据
# AppID 填小程序的 appid（与 project.private.config.json 里同一个）
WX_APP_ID=wx0000000000000000
# AppSecret 从公众平台「开发管理 → 开发设置」拿，只放服务端
WX_APP_SECRET=your-app-secret

# 订阅消息模板 ID（公众平台 → 订阅消息 → 模板详情）
OIL_SUBSCRIBE_TEMPLATE_ID=your-template-id

# 方向提醒模板 ID（可选）
# ⚠️ 这是一个「调整幅度为**文本类型**」的模板：
#   官方公告只给吨价、每升幅度还没采到时，主模板的 amount 字段填不了
#   （填 0 等于冒充「持平」，填吨价等于混口径），
#   只有文本类型的模板能把「幅度待公布」原样发出去。
# 这个 ID 必须同时登记在 server/src/services/subscribe-templates.js 的契约表里，
# 并且要加进小程序端 config/index.js 的 subscribeTemplateIds（用户要授权它）。
OIL_SUBSCRIBE_DIRECTION_TEMPLATE_ID=

# 自签 token 的密钥，随便取一串足够长的随机字符
OIL_TOKEN_SECRET=change-me-to-a-long-random-string

# 后端对外地址。必须是已在公众平台配置的 request 合法域名。
# 部署流水线用它做健康检查；小程序端 config/index.js 的 apiBaseUrl 要填同一个。
OIL_API_BASE_URL=https://oil-trend.uwakeme.top

# PostgreSQL 连接串
DATABASE_URL=postgres://user:password@127.0.0.1:5432/oil_trend

# 定时任务（cron 表达式，秒级六段）
OIL_COLLECT_CRON=0 */30 * * * *
OIL_ALERT_CRON=0 */10 * * * *
