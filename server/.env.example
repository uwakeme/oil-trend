# 复制成 .env 后填真实值。.env 不入库。

# 服务端口
PORT=3000

# 微信小程序凭据
# AppID 填小程序的 appid（与 project.private.config.json 里同一个）
WX_APP_ID=wx0000000000000000
# AppSecret 从公众平台「开发管理 → 开发设置」拿，只放服务端
WX_APP_SECRET=your-app-secret

# 订阅消息模板 ID（公众平台 → 订阅消息 → 模板详情）
OIL_SUBSCRIBE_TEMPLATE_ID=your-template-id

# 自签 token 的密钥，随便取一串足够长的随机字符
OIL_TOKEN_SECRET=change-me-to-a-long-random-string

# PostgreSQL 连接串
DATABASE_URL=postgres://user:password@127.0.0.1:5432/oil_trend

# 定时任务（cron 表达式，秒级六段）
OIL_COLLECT_CRON=0 */30 * * * *
OIL_ALERT_CRON=0 */10 * * * *
