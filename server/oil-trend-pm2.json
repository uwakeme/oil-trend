{
  "name": "oil-trend-server",
  "cwd": "__DEPLOY_DIR__/server",
  "script": "src/index.js",
  "exec_mode": "fork",
  "instances": 1,
  "autorestart": true,
  "watch": false,
  "max_memory_restart": "500M",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3002"
  },
  "error_file": "__DEPLOY_DIR__/logs/oil-trend-error.log",
  "out_file": "__DEPLOY_DIR__/logs/oil-trend-out.log",
  "merge_logs": true,
  "time": true
}
