@import "../../styles/tokens.wxss";
@import "../../styles/components.wxss";

.page-root {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(132rpx + env(safe-area-inset-bottom));
}

.page-head {
  margin-bottom: 28rpx;
}

.page-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: .18em;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.page-title {
  display: block;
  font-size: 46rpx;
  font-family: var(--font-title);
  letter-spacing: .04em;
  margin-bottom: 10rpx;
}

.page-sub {
  font-size: 20rpx;
  color: var(--muted);
}

/* ---------- 订阅状态 ---------- */
.subscription-card {
  border-radius: 38rpx;
  padding: 32rpx;
  background: #ede9dd;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.subscription-card.on {
  background: var(--green-soft);
}

.subscription-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: #fffdf6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 80rpx;
}

.subscription-icon .icon-inline {
  width: 40rpx;
  height: 40rpx;
}

.subscription-copy {
  flex: 1;
  min-width: 0;
}

.subscription-title {
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  font-weight: 700;
}

.subscription-text {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.5;
}

.subscription-button {
  border: none;
  background: var(--night);
  color: #fff;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  font-size: 18rpx;
  flex: 0 0 auto;
  line-height: 1.3;
}

.subscription-button.disabled {
  background: #c9c6bc;
  color: #7d7a72;
}

/* ---------- 规则 ---------- */
.rule-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.rule-title {
  display: flex;
  gap: 20rpx;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.rule-symbol {
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  background: var(--green-soft);
  color: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
}

.rule-symbol.amber {
  background: var(--amber-soft);
  color: var(--amber-ink);
}

.rule-symbol .icon-inline {
  width: 34rpx;
  height: 34rpx;
}

.rule-name {
  display: block;
  font-size: 24rpx;
  margin-bottom: 6rpx;
  font-weight: 650;
}

.rule-desc {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.5;
}

.condition-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.condition {
  border-radius: 20rpx;
  background: #f2f0e8;
  padding: 20rpx;
  flex: 1;
  min-width: 0;
}

.condition-label {
  display: block;
  font-size: 16rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.condition-value {
  font-size: 22rpx;
  font-weight: 600;
}

.rule-summary {
  margin: 26rpx 0 0;
  border-radius: 20rpx;
  background: #f2f0e8;
  padding: 20rpx 22rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.65;
}

/* ---------- 目标价 ---------- */
.target-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.target-title {
  font-size: 24rpx;
  font-weight: 650;
}

.target-current {
  font-size: 18rpx;
  color: var(--muted);
  margin-right: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stepper-button {
  width: 84rpx;
  height: 84rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: #f3f0e7;
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 84rpx;
  color: var(--ink);
}

.stepper-value {
  flex: 1;
  text-align: center;
}

.stepper-value-number {
  font-family: var(--font-num);
  font-size: 62rpx;
  font-weight: 500;
  line-height: 1;
}

.stepper-value-unit {
  font-size: 18rpx;
  color: var(--muted);
  margin-left: 6rpx;
}

.target-caption {
  text-align: center;
  margin: 16rpx 0 0;
  font-size: 18rpx;
  color: var(--green);
}

.target-caption.warn {
  color: var(--amber-ink);
}

/* ---------- 历史 ---------- */
.alert-history {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.history-check {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
}

.history-check .icon-inline {
  width: 28rpx;
  height: 28rpx;
}

.history-copy {
  flex: 1;
  min-width: 0;
}

.history-title {
  display: block;
  font-size: 20rpx;
  margin-bottom: 6rpx;
}

.history-time {
  display: block;
  font-size: 16rpx;
  color: var(--muted);
}

.history-price {
  font-family: var(--font-num);
  font-size: 26rpx;
  color: var(--green);
}

/* ---------- 授权弹层 ---------- */
.permission-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ebe8dd;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.permission-item .icon-inline {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.permission-name {
  display: block;
  font-size: 20rpx;
  margin-bottom: 6rpx;
  font-weight: 600;
}

.permission-desc {
  display: block;
  font-size: 16rpx;
  color: var(--muted);
  line-height: 1.5;
}

.sheet-secondary {
  width: 100%;
  margin-top: 18rpx;
}

.warn-box {
  border-radius: 20rpx;
  background: var(--red-soft);
  padding: 20rpx 22rpx;
  margin-top: 24rpx;
}

.warn-title {
  display: block;
  font-size: 20rpx;
  color: var(--red);
  margin-bottom: 8rpx;
  font-weight: 700;
}

.warn-text {
  font-size: 18rpx;
  line-height: 1.6;
  color: #7c443b;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
  width: 280rpx;
}
