@import "../../styles/tokens.wxss";
@import "../../styles/components.wxss";

.page-root {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(132rpx + env(safe-area-inset-bottom));
}

.page-head {
  margin-bottom: 28rpx;
}

.page-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: .18em;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.page-title {
  display: block;
  font-size: 46rpx;
  font-family: var(--font-title);
  letter-spacing: .04em;
  margin-bottom: 10rpx;
}

.page-sub {
  font-size: 20rpx;
  color: var(--muted);
}

.delay-badge {
  display: inline-flex;
  align-items: center;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  font-size: 18rpx;
  background: #eceae2;
  color: #626a64;
  margin-bottom: 24rpx;
}

/* ---------- 品种切换 ---------- */
.market-tabs {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.market-tab {
  flex: 1;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .4);
  padding: 26rpx;
  min-width: 0;
}

.market-tab.active {
  border-color: var(--night);
  background: var(--night);
  color: #fff;
}

.market-tab-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.market-tab-name {
  font-family: var(--font-num);
  font-size: 26rpx;
  letter-spacing: .03em;
}

.market-tab-label {
  font-size: 16rpx;
  opacity: .58;
}

.market-quote {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.market-quote-price {
  font-family: var(--font-num);
  font-size: 48rpx;
  font-weight: 500;
}

.market-quote-change {
  font-family: var(--font-num);
  font-size: 20rpx;
}

.market-tab.active .up { color: #ff8d80; }
.market-tab.active .down { color: #7edbad; }

/* ---------- 主行情 ---------- */
.market-main {
  border-radius: 40rpx;
  background: var(--white);
  border: 1rpx solid rgba(23, 35, 30, .07);
  padding: 34rpx;
  margin-bottom: 24rpx;
}

.market-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.market-heading-title {
  display: block;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.market-heading-code {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
}

.market-time {
  text-align: right;
  font-family: var(--font-num);
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.5;
}

.market-big {
  margin: 34rpx 0 4rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.market-big-value {
  font-family: var(--font-num);
  font-size: 90rpx;
  font-weight: 500;
  letter-spacing: -.025em;
  line-height: 1;
}

.market-big-unit {
  font-size: 20rpx;
  color: var(--muted);
}

.market-change {
  font-size: 24rpx;
  font-weight: 700;
  font-family: var(--font-num);
}

.market-axis {
  display: flex;
  justify-content: space-between;
  color: #969a94;
  font-family: var(--font-num);
  font-size: 16rpx;
  margin-top: 8rpx;
}

/* ---------- 快照 ---------- */
.market-detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.market-detail {
  background: rgba(255, 255, 255, .45);
  border-radius: 22rpx;
  padding: 20rpx;
  width: calc(50% - 10rpx);
  box-sizing: border-box;
}

.market-detail-label {
  display: block;
  font-size: 16rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.market-detail-value {
  font-family: var(--font-num);
  font-size: 28rpx;
  font-weight: 500;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
  width: 280rpx;
}
