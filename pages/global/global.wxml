<view class="tk page-root">
  <view wx:if="{{loading}}" class="state-box">
    <text class="state-box-title">正在获取行情…</text>
  </view>

  <view wx:elif="{{loadError}}" class="state-box">
    <text class="state-box-title">{{loadError}}</text>
    <button class="secondary-button retry-btn" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:else>
    <view class="page-head">
      <text class="page-kicker">GLOBAL CRUDE</text>
      <text class="page-title">国际油价</text>
      <text class="page-sub">原油市场参考 · 美元 / 桶</text>
    </view>

    <!-- 数据来源：后端挂了回落演示数据时必须看得见 -->
    <!-- aria-live：来源变了（后端挂了变黄）要能被读屏软件念出来 -->
    <view class="source-bar {{sourceWarn ? 'warn' : ''}}" wx:if="{{sourceText}}" role="status" aria-live="polite">
      <text class="source-bar-text">{{sourceText}}</text>
    </view>

    <!-- 后端明确说「还没采到行情」：显示空态，不回落演示数据也不当加载失败 -->
    <view wx:if="{{dataEmpty}}" class="state-box">
      <text class="state-box-title">暂无行情数据</text>
      <text>国际行情来源接入后会自动显示</text>
    </view>

    <text class="delay-badge" wx:if="{{!dataEmpty}}">{{delayText}}</text>

    <view class="market-tabs" wx:if="{{!dataEmpty}}">
      <view
        wx:for="{{tabs}}"
        wx:key="symbol"
        class="market-tab {{item.symbol === symbol ? 'active' : ''}}"
        data-symbol="{{item.symbol}}"
        bindtap="onSelectMarket"
      >
        <view class="market-tab-top">
          <text class="market-tab-name">{{item.code}}</text>
          <text class="market-tab-label">{{item.label}}</text>
        </view>
        <view class="market-quote">
          <text class="market-quote-price">{{item.priceText}}</text>
          <text class="market-quote-change {{item.direction}}">{{item.changeText}}</text>
        </view>
      </view>
    </view>

    <view class="market-main" wx:if="{{!dataEmpty}}">
      <view class="market-heading">
        <view>
          <text class="market-heading-title">{{market.name}}</text>
          <text class="market-heading-code">{{market.code}}</text>
        </view>
        <view class="market-time"><text>{{market.quoteTime}}</text><text class="foot-line">{{market.delayText}}</text></view>
      </view>

      <view class="market-big">
        <text class="market-big-value num">{{market.priceText}}</text>
        <text class="market-big-unit">美元 / 桶</text>
      </view>
      <text class="market-change {{market.direction}}">{{market.changeText}}</text>

      <!-- 点少于 2 个画不出曲线：不渲染图表组件，改显示空态文案 -->
      <trend-chart wx:if="{{hasChart}}" points="{{market.points}}" mode="line" height="{{145}}" direction="{{market.direction}}" />
      <view wx:else class="chart-empty">
        <text class="chart-empty-text">暂无行情数据</text>
        <text class="chart-empty-hint">行情来源接入后会自动显示</text>
      </view>

      <view class="market-axis" wx:if="{{hasChart}}">
        <text wx:for="{{market.axis}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="period-row" style="margin:26rpx 0 0">
        <view
          wx:for="{{periods}}"
          wx:key="key"
          class="period-item {{item.key === period ? 'active' : ''}}"
          data-period="{{item.key}}"
          bindtap="onSelectPeriod"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="info-strip">
      <image class="info-strip-icon" src="/assets/icons/info-amber.png" mode="aspectFit" />
      <view>
        <text class="info-strip-title">国际油价不等于国内加油价</text>
        <text class="info-strip-text">国内成品油还受定价周期、汇率、税费及流通成本等因素影响，此页仅作市场趋势参考。</text>
      </view>
    </view>

    <view class="card" wx:if="{{!dataEmpty}}">
      <view class="card-title-row">
        <text class="card-title">今日市场快照</text>
        <text class="micro">USD / BBL</text>
      </view>
      <view class="market-detail-grid">
        <view class="market-detail">
          <text class="market-detail-label">今开</text>
          <text class="market-detail-value">{{market.openText}}</text>
        </view>
        <view class="market-detail">
          <text class="market-detail-label">昨收</text>
          <text class="market-detail-value">{{market.prevText}}</text>
        </view>
        <view class="market-detail">
          <text class="market-detail-label">最高</text>
          <text class="market-detail-value">{{market.highText}}</text>
        </view>
        <view class="market-detail">
          <text class="market-detail-label">最低</text>
          <text class="market-detail-value">{{market.lowText}}</text>
        </view>
      </view>
    </view>

    <view class="data-footnote"><text>实时或延时状态由正式数据源决定</text><text class="foot-line">{{sourceNote}}</text></view>
  </block>
</view>
