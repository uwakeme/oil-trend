<view class="tk page-root">

  <view wx:if="{{loading}}" class="state-box">
    <text class="state-box-title">正在获取油价…</text>
  </view>

  <view wx:elif="{{loadError}}" class="state-box">
    <text class="state-box-title">{{loadError}}</text>
    <button class="secondary-button retry-btn" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:else>
    <!-- 来源提示：后端挂了回落演示数据时必须看得见 -->
    <!-- aria-live：来源变了（后端挂了变黄）要能被读屏软件念出来 -->
    <view class="source-bar {{sourceWarn ? 'warn' : ''}}" wx:if="{{sourceText}}" role="status" aria-live="polite">
      <text class="source-bar-text">{{sourceText}}</text>
    </view>

    <!-- 顶部：地区与设置 -->
    <view class="app-header">
      <view class="header-left">
        <text class="header-kicker">当前油价</text>
        <view class="location-button" bindtap="onPickRegion">
          <image class="icon-inline" src="/assets/icons/pin-ink.png" mode="aspectFit" />
          <text class="city-name">{{region.fullName}}</text>
          <image class="icon-inline" src="/assets/icons/chevron-muted.png" mode="aspectFit" />
        </view>
      </view>
      <view class="icon-button" bindtap="onOpenAbout">
        <image class="icon-inline" src="/assets/icons/settings-ink.png" mode="aspectFit" />
      </view>
    </view>

    <!-- 定位提示：检测到人在别的省，或定位被拒后给一个开启入口 -->
    <view wx:if="{{locateHint}}" class="locate-hint" bindtap="onLocateHintTap">
      <image class="icon-inline" src="/assets/icons/pin-ink.png" mode="aspectFit" />
      <text>{{locateHint}}</text>
    </view>

    <!-- 后端明确说「还没采到数据」：显示空态，不回落演示数据也不当加载失败 -->
    <view wx:if="{{dataEmpty}}" class="state-box">
      <text class="state-box-title">该地区暂无油价数据</text>
      <text>采集到该地区挂牌价后会自动显示</text>
    </view>

    <!-- 主价格卡 -->
    <view class="price-hero" wx:if="{{!dataEmpty}}">
      <text class="hero-ghost num">{{hero.id}}</text>
      <view class="price-topline">
        <view class="fuel-label">
          <text class="fuel-badge">{{hero.id}}</text>
          <text>{{hero.name}}</text>
        </view>
        <text wx:if="{{updatedLabel}}" class="updated">{{updatedLabel}}</text>
      </view>
      <view class="hero-price">
        <text class="hero-price-value num">{{hero.priceText}}</text>
        <text class="hero-price-unit">元 / 升</text>
      </view>
      <view class="price-change">
        <text class="badge {{hero.direction}}">{{hero.changeText}}</text>
        <view class="text-button" bindtap="goTrend">
          <text>查看走势</text>
          <image class="icon-inline" src="/assets/icons/arrow-muted.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- 其余油品：固定 92/95/98/0 顺序，选中项进入大卡后隐藏 -->
    <view class="other-fuels" wx:if="{{!dataEmpty}}">
      <block wx:for="{{prices}}" wx:key="id">
        <view wx:if="{{item.id !== fuelId}}" class="other-fuel" data-fuel="{{item.id}}" bindtap="onSelectFuel">
          <text class="other-fuel-name">{{item.name}}</text>
          <view class="other-fuel-row">
            <text class="other-fuel-price num">{{item.priceText}}</text>
            <text class="other-fuel-unit">元/升</text>
          </view>
          <text class="other-fuel-change {{item.direction}}">{{item.changeText}}</text>
        </view>
      </block>
    </view>

    <!-- 下一轮调价窗口 -->
    <view class="next-card" wx:if="{{window.hasWindow}}">
      <view class="next-top">
        <text class="next-title">{{window.titleText}}</text>
        <text class="countdown" wx:if="{{window.expired}}">已过 <text class="num">{{window.passedDays}}</text> 天 · 等待下一轮公布</text>
        <text class="countdown" wx:elif="{{window.daysLeft === 0}}">就是今天</text>
        <text class="countdown" wx:else>距窗口 <text class="num">{{window.daysLeft}}</text> 天</text>
      </view>
      <view class="next-main">
        <view class="next-date">
          <text class="next-date-value">{{window.dateText}}</text>
          <text class="next-date-note">预计时间 · 以官方公告为准</text>
        </view>
        <!-- 窗口已过期时不渲染预测区：挂着的预测早就失效了 -->
        <view class="forecast" wx:if="{{!window.expired}}">
          <text class="forecast-value num {{forecast.direction}}">{{forecast.text}}</text>
          <text class="forecast-caption">{{forecast.caption}}</text>
        </view>
      </view>
    </view>

    <!-- 近 30 天走势 -->
    <view class="card" wx:if="{{!dataEmpty}}">
      <view class="card-title-row">
        <text class="card-title">近 30 天走势</text>
        <view class="card-link" bindtap="goTrend">{{hero.name}}　›</view>
      </view>
      <!-- 点少于 2 个画不出曲线：不渲染图表组件，改显示空态文案 -->
      <trend-chart wx:if="{{trend.hasChart}}" points="{{trend.points}}" mode="step" height="{{70}}" direction="{{trend.direction}}" visible="{{!sheetType}}" />
      <view wx:else class="chart-empty">
        <text class="chart-empty-text">暂无走势数据</text>
        <text class="chart-empty-hint">该地区历史价格正在积累中</text>
      </view>
      <view class="chart-labels" wx:if="{{trend.hasChart}}">
        <text wx:for="{{trend.labels}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 最新调价通知 -->
    <view class="card">
      <view class="card-title-row">
        <text class="card-title">最新调价通知</text>
        <view class="card-link" bindtap="goNotice">全部通知 ›</view>
      </view>
      <!-- 没有正式通知：只说没有，不拼「--」日期，也不给点不动的详情入口 -->
      <view wx:if="{{notice.empty}}" class="notice-empty">
        <text class="notice-empty-title">暂无正式调价通知</text>
        <text class="notice-empty-hint">正式公告来源接入后自动同步</text>
      </view>
      <view wx:else class="notice-preview" bindtap="onOpenNotice">
        <view class="notice-date-block">
          <text class="notice-day num">{{notice.day}}</text>
          <text class="notice-month">{{notice.month}}</text>
        </view>
        <view class="notice-preview-body">
          <text class="notice-preview-title">{{notice.title}}</text>
          <text class="notice-preview-desc">
            <text wx:if="{{notice.value === '--'}}" class="{{notice.changeDirection}}">{{notice.fuelName}} 调价幅度待公布</text>
            <text wx:else class="{{notice.changeDirection}}">{{notice.fuelName}}每升{{notice.verb}} {{notice.value}} 元</text> · 查看通知详情 ›
          </text>
        </view>
      </view>
    </view>

    <view class="data-footnote">{{sourceNote}}</view>
  </block>

  <!-- 地区选择 -->
  <bottom-sheet visible="{{sheetType === 'city'}}" title="选择油价地区" scroll-height="84vh" bind:close="onSheetClose">
    <view class="sheet-body">不同地区零售价可能不同，你选过的地区会被记住。</view>

    <!-- 当前位置：手动再定位一次 -->
    <view class="city-current {{locating ? 'busy' : ''}}" bindtap="onLocateCurrent">
      <image class="icon-inline" src="/assets/icons/target-amber.png" mode="aspectFit" />
      <view class="city-current-body">
        <text class="city-current-title">{{locating ? '定位中…' : '当前位置'}}</text>
        <text class="city-current-desc">{{locateCurrentDesc}}</text>
      </view>
    </view>

    <!-- 31 个省，滚动翻找太慢，给个搜索框 -->
    <view class="city-search">
      <input class="city-search-input" type="text" value="{{regionKeyword}}"
        placeholder="搜省份或城市，如 广东 / 广州 / gd"
        placeholder-class="city-search-placeholder"
        confirm-type="search" bindinput="onRegionSearch" />
      <text wx:if="{{regionKeyword}}" class="city-search-clear" bindtap="onClearRegionSearch">✕</text>
    </view>
    <view wx:for="{{regions}}" wx:key="code" class="city-option {{item.code === region.code ? 'active' : ''}}" data-code="{{item.code}}" bindtap="onSelectRegion">
      <view>
        <text class="city-option-name">{{item.fullName}}</text>
        <text class="city-option-price">92# {{item.priceText}} 元/升</text>
      </view>
      <text wx:if="{{item.code === region.code}}" class="city-option-check">✓</text>
    </view>
    <view wx:if="{{regions.length === 0}}" class="city-empty">
      <text class="city-empty-text">没有找到「{{regionKeyword}}」对应的地区</text>
      <text class="city-empty-hint">试试省份名（广东）、城市名（广州）或拼音首字母（gd）</text>
    </view>
  </bottom-sheet>

  <!-- 通知详情 -->
  <bottom-sheet visible="{{sheetType === 'notice' && !notice.empty}}" title="调价通知详情" scroll-height="72vh" bind:close="onSheetClose">
    <view class="notice-detail-label">
      <text class="badge neutral">正式结果</text>
      <text class="badge {{notice.changeDirection}}">{{notice.verb}}</text>
    </view>
    <text class="detail-title">{{notice.title}}</text>
    <view class="sheet-body" style="margin-top:12rpx">{{notice.executeText}}</view>
    <view class="sheet-body" style="margin-top:8rpx">{{notice.summaryText}}</view>
    <view class="detail-price-grid">
      <view wx:for="{{notice.prices}}" wx:key="id" class="detail-price">
        <text class="detail-price-name">{{item.name}}</text>
        <view class="detail-price-row">
          <text class="detail-price-value">{{item.priceText}}</text>
          <text class="detail-price-delta {{item.direction}}">{{item.deltaText}}</text>
        </view>
      </view>
    </view>
    <view class="source-box">
      <text class="source-box-title">来源与原文</text>
      <text class="source-box-text">{{notice.sourceLine}}</text>
    </view>
    <button class="primary-button dark" bindtap="onSheetClose">知道了</button>
  </bottom-sheet>

  <!-- 数据来源说明 -->
  <bottom-sheet visible="{{sheetType === 'about'}}" title="数据来源与说明" scroll-height="46vh" bind:close="onSheetClose">
    <view class="about-row">
      <text class="about-label">当前数据源</text>
      <text class="about-value">{{sourceName}}</text>
    </view>
    <view wx:if="{{updatedLabel}}" class="about-row">
      <text class="about-label">数据更新时间</text>
      <text class="about-value">{{updatedLabel}}</text>
    </view>
    <view class="about-row">
      <text class="about-label">服务状态</text>
      <text class="about-value">{{cloudStatus}}</text>
    </view>
    <view class="source-box">
      <text class="source-box-title">关于数据</text>
      <text class="source-box-text">{{aboutNote}}</text>
    </view>
    <button class="primary-button dark" bindtap="onSheetClose">知道了</button>
  </bottom-sheet>

</view>
