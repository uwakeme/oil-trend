@import "../../styles/tokens.wxss";
@import "../../styles/components.wxss";

.page-root {
  min-height: 100vh;
  padding: 24rpx 32rpx 40rpx;
}

/* ---------- 顶部 ---------- */
.app-header {
  min-height: 96rpx;
  padding-right: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  position: relative;
}

.header-left {
  min-width: 0;
}

.header-kicker {
  font-size: 18rpx;
  letter-spacing: .15em;
  color: var(--muted);
  margin-bottom: 6rpx;
  display: block;
}

.location-button {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.location-button .city-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.icon-inline {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.location-button .icon-inline {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
}

.icon-button {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, .5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-button .icon-inline {
  width: 32rpx;
  height: 32rpx;
}

/* ---------- 定位提示 ---------- */
.locate-hint {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin: -10rpx 0 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--amber-soft);
  color: var(--amber-ink);
  font-size: 20rpx;
}

.locate-hint .icon-inline {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
}

/* ---------- 主价格卡 ---------- */
.price-hero {
  background: var(--night);
  color: #fffdf6;
  border-radius: 46rpx;
  padding: 40rpx 38rpx 34rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.hero-ghost {
  position: absolute;
  right: -14rpx;
  top: -54rpx;
  font-family: var(--font-num);
  font-size: 276rpx;
  line-height: 1;
  color: rgba(255, 255, 255, .035);
  font-weight: 800;
  pointer-events: none;
}

.price-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.fuel-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .72);
}

.fuel-badge {
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: var(--amber);
  color: var(--night);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-num);
  font-size: 24rpx;
  font-weight: 700;
}

.updated {
  font-size: 18rpx;
  color: rgba(255, 255, 255, .46);
}

.hero-price {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin: 22rpx 0 26rpx;
  position: relative;
  z-index: 1;
}

.hero-price-value {
  font-family: var(--font-num);
  font-size: 114rpx;
  line-height: .95;
  font-weight: 500;
  letter-spacing: -.035em;
}

.hero-price-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, .56);
  padding-bottom: 14rpx;
}

.price-change {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.price-change .badge {
  background: rgba(91, 202, 147, .15);
  color: #8de0b4;
}

.price-change .badge.rise {
  background: rgba(255, 138, 124, .16);
  color: #ff9b8e;
}

.text-button {
  display: inline-flex;
  gap: 8rpx;
  align-items: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, .68);
}

.text-button .icon-inline {
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 22rpx;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
  width: 280rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.6;
  color: var(--ink);
}

.city-option-check {
  color: var(--green);
  font-weight: 800;
  font-size: 30rpx;
}

/* ---------- 其余油品小卡 ---------- */
.other-fuels {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.other-fuel {
  flex: 1;
  min-width: 0;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, .45);
  border-radius: 24rpx;
  padding: 22rpx 20rpx;
}

.other-fuel-name {
  display: block;
  color: var(--muted);
  font-size: 20rpx;
  margin-bottom: 10rpx;
}

.other-fuel-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.other-fuel-price {
  font-size: 36rpx;
  font-weight: 550;
}

.other-fuel-unit {
  font-size: 18rpx;
  color: var(--muted);
}

.other-fuel-change {
  display: block;
  font-size: 18rpx;
  margin-top: 8rpx;
}

/* 无方向（持平 / 幅度未知）用中性色，别让空状态看起来像涨跌 */
.other-fuel-change.flat { color: var(--muted); }

/* ---------- 调价窗口 ---------- */
.next-card {
  background: #ece8dc;
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.next-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 32rpx;
  bottom: 32rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--amber);
}

.next-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.next-title {
  font-size: 22rpx;
  color: var(--muted);
}

.countdown {
  font-size: 20rpx;
  color: var(--muted);
}

.countdown .num {
  color: var(--ink);
  font-weight: 600;
}

.next-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.next-date {
  min-width: 0;
}

.next-date-value {
  display: block;
  font-size: 38rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}

.next-date-note {
  font-size: 18rpx;
  color: var(--muted);
}

.forecast {
  text-align: right;
}

.forecast-value {
  display: block;
  font-family: var(--font-num);
  font-size: 44rpx;
  font-weight: 550;
  line-height: 1.1;
}

.forecast-caption {
  font-size: 18rpx;
  color: var(--muted);
}

/* ---------- 迷你走势图 ---------- */
.chart-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 16rpx;
  color: #92968f;
}

/* ---------- 走势图空态 ---------- */
/* 点不够画不出曲线时显示这几行，别拿一个孤点装成有走势 */
.chart-empty {
  padding: 36rpx 0 28rpx;
  text-align: center;
}
.chart-empty-text {
  display: block;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.chart-empty-hint {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
}

/* ---------- 最新通知 ---------- */
/* 没有正式通知时的空态 */
.notice-empty {
  padding: 26rpx 0 18rpx;
}
.notice-empty-title {
  display: block;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 600;
  margin-bottom: 10rpx;
}
.notice-empty-hint {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.5;
}

.notice-preview {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
}

.notice-date-block {
  width: 86rpx;
  flex: 0 0 86rpx;
  border-right: 1rpx solid var(--line);
}

.notice-day {
  display: block;
  font-family: var(--font-num);
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.1;
}

.notice-month {
  font-size: 18rpx;
  color: var(--muted);
}

.notice-preview-body {
  flex: 1;
  min-width: 0;
}

.notice-preview-title {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.notice-preview-desc {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.5;
}

/* ---------- 弹层内样式 ---------- */

/* ---------- 当前位置入口 ---------- */
.city-current {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid var(--line);
  background: #fffef9;
  border-radius: 26rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
}

.city-current.busy {
  opacity: .55;
}

.city-current .icon-inline {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
}

.city-current-body {
  flex: 1;
  min-width: 0;
}

.city-current-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.city-current-desc {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.5;
}

/* 地区搜索：31 个省，滚动翻找太慢，给个搜索框 */
.city-search {
  display: flex;
  align-items: center;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.city-search-input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.city-search-placeholder {
  color: var(--muted);
}

.city-search-clear {
  font-size: 30rpx;
  color: var(--muted);
  padding: 0 4rpx;
}

.city-empty {
  padding: 60rpx 0 40rpx;
  text-align: center;
}

.city-empty-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.city-empty-hint {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
}

.city-option {
  border: 1rpx solid var(--line);
  background: #fffef9;
  border-radius: 26rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.city-option.active {
  border-color: var(--amber);
}

.city-option-name {
  display: block;
  font-size: 24rpx;
  margin-bottom: 6rpx;
  font-weight: 600;
}

.city-option-price {
  font-size: 18rpx;
  color: var(--muted);
}

.notice-detail-label {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.detail-price-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 32rpx 0;
}

.detail-price {
  border-radius: 24rpx;
  background: #ebe8dd;
  padding: 24rpx;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

.detail-price-name {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.detail-price-value {
  font-family: var(--font-num);
  font-size: 36rpx;
  font-weight: 500;
}

.detail-price-delta {
  font-size: 20rpx;
  font-weight: 700;
}

.source-box {
  border-left: 4rpx solid var(--amber);
  padding-left: 20rpx;
  margin: 32rpx 0;
}

.source-box-title {
  display: block;
  font-size: 20rpx;
  margin-bottom: 8rpx;
  font-weight: 700;
}

.source-box-text {
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.6;
}

.about-row {
  margin-bottom: 28rpx;
}

.about-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  display: block;
}

.about-value {
  font-size: 24rpx;
  line-height: 1.6;
}
