@import "../../styles/tokens.wxss";
@import "../../styles/components.wxss";

.page-root {
  min-height: 100vh;
  padding: 24rpx 32rpx 40rpx;
}

.page-head {
  margin-bottom: 28rpx;
}

.page-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: .18em;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.page-title {
  display: block;
  font-size: 46rpx;
  font-family: var(--font-title);
  letter-spacing: .04em;
  margin-bottom: 10rpx;
}

.page-sub {
  font-size: 20rpx;
  color: var(--muted);
}

/* ---------- 窗口卡 ---------- */
.window-card {
  border-radius: 40rpx;
  background: var(--night);
  color: #fff;
  padding: 36rpx;
  margin-bottom: 28rpx;
}

.window-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, .58);
  margin-bottom: 16rpx;
  display: block;
}

.window-date {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 0;
}

.window-date-value {
  font-family: var(--font-num);
  font-size: 56rpx;
  font-weight: 500;
  line-height: 1;
}

.window-date-note {
  font-size: 20rpx;
  color: rgba(255, 255, 255, .55);
  padding-bottom: 6rpx;
}

.window-progress {
  height: 8rpx;
  background: rgba(255, 255, 255, .12);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.window-progress-bar {
  display: block;
  height: 100%;
  background: var(--amber);
  border-radius: 6rpx;
}

.window-meta {
  display: flex;
  justify-content: space-between;
  font-size: 16rpx;
  color: rgba(255, 255, 255, .46);
}

/* 日期下面那行口径说明：用推算值时写「推算 · 非官方」 */
.window-date-source {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, .5);
  margin: 12rpx 0 26rpx;
}

/* ---------- 下次通知 ---------- */
/* 下一轮调价公告的发布日 —— 用户最想知道「什么时候会再收到通知」 */
.window-notice {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .14);
}

.window-notice-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.window-notice-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, .55);
  flex: 0 0 auto;
}

.window-notice-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.window-notice-note {
  display: block;
  font-size: 16rpx;
  color: rgba(255, 255, 255, .45);
  margin-top: 10rpx;
  line-height: 1.5;
}

/* ---------- 同步状态 ---------- */
.sync-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 6rpx 26rpx;
  font-size: 18rpx;
  color: var(--muted);
}

.sync-status {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.sync-status::before {
  content: "";
  width: 12rpx;
  height: 12rpx;
  background: var(--green);
  border-radius: 50%;
}

.sync-status.muted::before {
  background: var(--muted);
}

.sync-status.warn::before {
  background: var(--amber);
}

.sync-status.error::before {
  background: var(--red);
}

/* 来源提示：主源不可用、备源接管时说一句（数据是新的，但来源变了） */
.sync-hint {
  display: block;
  margin: -14rpx 6rpx 26rpx;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.5;
}

/* ---------- 筛选 ---------- */
.filter-row {
  display: flex;
  gap: 30rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 8rpx;
}

.filter-item {
  padding: 16rpx 2rpx 20rpx;
  font-size: 20rpx;
  color: var(--muted);
  position: relative;
}

.filter-item.active {
  color: var(--ink);
  font-weight: 750;
}

.filter-item.active::after {
  content: "";
  height: 4rpx;
  background: var(--night);
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
}

/* ---------- 通知列表 ---------- */
.notice-item {
  border-bottom: 1rpx solid var(--line);
  padding: 30rpx 2rpx;
}

.notice-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.notice-meta-time {
  font-family: var(--font-num);
  font-size: 18rpx;
  color: var(--muted);
}

.notice-item-title {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  margin-bottom: 14rpx;
}

/* 官方公告给的方向与吨价（发改委公告只给这个） */
.notice-item-official {
  display: block;
  font-size: 19rpx;
  color: var(--ink);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

/* 挂牌价测算值的来源标注 —— 不能让人把它当成官方公布值 */
.notice-measured-tag {
  display: block;
  font-size: 16rpx;
  color: var(--amber-ink);
  background: var(--amber-soft);
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-top: 12rpx;
  line-height: 1.4;
}

.notice-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 18rpx;
  color: var(--muted);
  gap: 16rpx;
}

.notice-change {
  font-family: var(--font-num);
  font-size: 22rpx;
  font-weight: 700;
  flex: 0 0 auto;
}

.notice-detail-label {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.notice-detail-title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.6;
  color: var(--ink);
}

.detail-price-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 32rpx 0;
}

.detail-price {
  border-radius: 24rpx;
  background: #ebe8dd;
  padding: 24rpx;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

.detail-price-name {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.detail-price-value {
  font-family: var(--font-num);
  font-size: 36rpx;
  font-weight: 500;
}

.detail-price-delta {
  font-size: 20rpx;
  font-weight: 700;
}

/* 调价前后价：表头（调价前 → 调价后 · 元/升） */
.detail-price-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 28rpx;
}

.detail-price-head-title {
  font-size: 22rpx;
  font-weight: 700;
}

.detail-price-head-unit {
  font-size: 18rpx;
  color: var(--muted);
}

/* 调价前的价格：弱化显示，主角是调价后的价 */
.detail-price-before {
  font-family: var(--font-num);
  font-size: 26rpx;
  color: var(--muted);
}

.detail-price-arrow {
  font-size: 22rpx;
  color: var(--muted);
}

/* 每升幅度 + 来源标签 */
.detail-price-foot {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.detail-price-tag {
  font-size: 16rpx;
  color: var(--amber-ink);
  background: var(--amber-soft);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}


.source-box {
  border-left: 4rpx solid var(--amber);
  padding-left: 20rpx;
  margin: 32rpx 0;
}

.source-box-title {
  display: block;
  font-size: 20rpx;
  margin-bottom: 8rpx;
  font-weight: 700;
}

.source-box-text {
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.6;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
  width: 280rpx;
}

/* 原文链接：小程序打不开外部网页，点一下把链接复制到剪贴板 */
.source-link {
  display: inline-block;
  /* 上一行的来源文字是 inline 的，不给左边距就跟文字粘在一起 */
  margin-left: 16rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--green);
}
