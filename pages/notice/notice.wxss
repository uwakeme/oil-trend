@import "../../styles/tokens.wxss";
@import "../../styles/components.wxss";

.page-root {
  min-height: 100vh;
  padding: 24rpx 32rpx 40rpx;
}

.page-head {
  margin-bottom: 28rpx;
}

.page-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: .18em;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.page-title {
  display: block;
  font-size: 46rpx;
  font-family: var(--font-title);
  letter-spacing: .04em;
  margin-bottom: 10rpx;
}

.page-sub {
  font-size: 20rpx;
  color: var(--muted);
}

/* ---------- 窗口卡 ---------- */
.window-card {
  border-radius: 40rpx;
  background: var(--night);
  color: #fff;
  padding: 36rpx;
  margin-bottom: 28rpx;
}

.window-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, .58);
  margin-bottom: 16rpx;
  display: block;
}

.window-date {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.window-date-value {
  font-family: var(--font-num);
  font-size: 56rpx;
  font-weight: 500;
  line-height: 1;
}

.window-date-note {
  font-size: 20rpx;
  color: rgba(255, 255, 255, .55);
  padding-bottom: 6rpx;
}

.window-progress {
  height: 8rpx;
  background: rgba(255, 255, 255, .12);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.window-progress-bar {
  display: block;
  height: 100%;
  background: var(--amber);
  border-radius: 6rpx;
}

.window-meta {
  display: flex;
  justify-content: space-between;
  font-size: 16rpx;
  color: rgba(255, 255, 255, .46);
}

/* ---------- 同步状态 ---------- */
.sync-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 6rpx 26rpx;
  font-size: 18rpx;
  color: var(--muted);
}

.sync-status {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.sync-status::before {
  content: "";
  width: 12rpx;
  height: 12rpx;
  background: var(--green);
  border-radius: 50%;
}

.sync-status.warn::before {
  background: var(--amber);
}

.sync-status.error::before {
  background: var(--red);
}

/* ---------- 筛选 ---------- */
.filter-row {
  display: flex;
  gap: 30rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 8rpx;
}

.filter-item {
  padding: 16rpx 2rpx 20rpx;
  font-size: 20rpx;
  color: var(--muted);
  position: relative;
}

.filter-item.active {
  color: var(--ink);
  font-weight: 750;
}

.filter-item.active::after {
  content: "";
  height: 4rpx;
  background: var(--night);
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
}

/* ---------- 通知列表 ---------- */
.notice-item {
  border-bottom: 1rpx solid var(--line);
  padding: 30rpx 2rpx;
}

.notice-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.notice-meta-time {
  font-family: var(--font-num);
  font-size: 18rpx;
  color: var(--muted);
}

.notice-item-title {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  margin-bottom: 14rpx;
}

.notice-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 18rpx;
  color: var(--muted);
  gap: 16rpx;
}

.notice-change {
  font-family: var(--font-num);
  font-size: 22rpx;
  font-weight: 700;
  flex: 0 0 auto;
}

.notice-detail-label {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.notice-detail-title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.6;
  color: var(--ink);
}

.detail-price-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 32rpx 0;
}

.detail-price {
  border-radius: 24rpx;
  background: #ebe8dd;
  padding: 24rpx;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

.detail-price-name {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.detail-price-value {
  font-family: var(--font-num);
  font-size: 36rpx;
  font-weight: 500;
}

.detail-price-delta {
  font-size: 20rpx;
  font-weight: 700;
}

.source-box {
  border-left: 4rpx solid var(--amber);
  padding-left: 20rpx;
  margin: 32rpx 0;
}

.source-box-title {
  display: block;
  font-size: 20rpx;
  margin-bottom: 8rpx;
  font-weight: 700;
}

.source-box-text {
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.6;
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
  width: 280rpx;
}
