@import "../../styles/tokens.wxss";
@import "../../styles/components.wxss";

.page-root {
  min-height: 100vh;
  padding: 24rpx 32rpx 40rpx;
}

.page-head {
  margin-bottom: 28rpx;
}

.page-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: .18em;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.page-title {
  display: block;
  font-size: 46rpx;
  font-family: var(--font-title);
  letter-spacing: .04em;
  margin-bottom: 10rpx;
}

.page-sub {
  font-size: 20rpx;
  color: var(--muted);
}

/* ---------- 摘要 ---------- */
.trend-summary {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.trend-price-row {
  display: flex;
  align-items: baseline;
}

.trend-price {
  font-size: 68rpx;
  font-weight: 500;
  line-height: 1;
}

.trend-unit {
  font-size: 20rpx;
  color: var(--muted);
  margin-left: 8rpx;
}

.trend-delta {
  text-align: right;
}

.trend-delta-value {
  display: block;
  font-size: 30rpx;
  margin-bottom: 4rpx;
}

.trend-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 16rpx;
  color: #92968f;
}

/* ---------- 统计 ---------- */
.stat-grid {
  display: flex;
  border-top: 1rpx solid var(--line);
  padding-top: 24rpx;
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--line);
}

.stat:last-child {
  border-right: none;
}

.stat-label {
  display: block;
  font-size: 16rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 550;
}

/* ---------- 调价节点 ---------- */
.event-list {
  display: flex;
  flex-direction: column;
}

.event-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  min-height: 102rpx;
}

.event-date {
  width: 96rpx;
  flex: 0 0 96rpx;
  font-family: var(--font-num);
  font-size: 20rpx;
  color: var(--muted);
  padding-top: 4rpx;
}

.event-track {
  flex: 0 0 26rpx;
  position: relative;
  align-self: stretch;
  display: flex;
  justify-content: center;
}

.event-track::before {
  content: "";
  width: 1rpx;
  background: var(--line);
  position: absolute;
  top: 18rpx;
  bottom: -6rpx;
}

.event-item:last-child .event-track::before {
  display: none;
}

.event-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--green);
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 0 6rpx var(--paper);
}

.event-item.rise .event-dot {
  background: var(--red);
}

.event-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 24rpx;
}

.event-title {
  display: block;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.event-sub {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
}

.event-value {
  font-size: 22rpx;
  font-weight: 700;
  padding-top: 4rpx;
  font-family: var(--font-num);
}

.retry-btn {
  margin-top: 28rpx;
  display: inline-block;
  width: 280rpx;
}
